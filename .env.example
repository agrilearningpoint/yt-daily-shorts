# ============================================================
# YT Daily Shorts — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
#
# All keys prefixed with YT_ to avoid collisions.
# ============================================================

# === LLM Configuration ===
YT_GEMINI_API_KEY=your_gemini_api_key_here
YT_GROQ_API_KEY=your_groq_api_key_here  # Optional: fallback LLM provider

# === Telegram ===
YT_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
YT_TELEGRAM_CHAT_ID=your_telegram_chat_id

# === YouTube ===
# Store OAuth JSON as GitHub secrets, not here.
# These are base64-encoded JSON strings used by GitHub Actions.
# YT_YOUTUBE_CLIENT_SECRET_JSON=base64_encoded_json
# YT_YOUTUBE_TOKEN_JSON=base64_encoded_json

# === Media APIs ===
YT_PEXELS_API_KEY=your_pexels_key      # Optional: stock video/image provider
YT_PIXABAY_API_KEY=your_pixabay_key    # Optional: stock video/image provider
YT_HF_TOKEN=your_huggingface_token     # Optional: for AI model access

# === Database ===
YT_MONGODB_URI=                         # Optional: uses SQLite by default

# === Storage ===
YT_CLOUDFLARE_R2_ACCESS_KEY=           # Optional: cloud backup for rendered videos
YT_CLOUDFLARE_R2_SECRET_KEY=           # Optional: cloud backup for rendered videos

# === General ===
YT_DRY_RUN=true                        # Set to false to enable real uploads
YT_DEBUG=false                         # Set to true for verbose logging
YT_TIMEZONE=Asia/Kolkata               # IANA timezone for scheduling
