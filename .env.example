# Copy to .env for local runs. GitHub Actions uses repository secrets instead.

# LLM providers (any subset; tried in order gemini -> groq -> mistral -> openrouter -> nvidia -> ollama)
YT_GEMINI_API_KEY=
YT_GROQ_API_KEY=
YT_MISTRAL_API_KEY=
YT_OPENROUTER_API_KEY=
YT_NVIDIA_API_KEY=
YT_OLLAMA_API_KEY=

# Telegram
YT_TELEGRAM_BOT_TOKEN=
YT_TELEGRAM_CHAT_ID=

# YouTube (raw JSON, base64 JSON, or a file path)
YT_YOUTUBE_CLIENT_SECRET_JSON=client_secret.json
YT_YOUTUBE_TOKEN_JSON=
YT_YOUTUBE_PRIVACY=public

# Optional stock media
YT_PEXELS_API_KEY=
YT_PIXABAY_API_KEY=

# General
YT_DRY_RUN=true
YT_CHANNEL_NAME=Daily Hindi Shorts
YT_TIMEZONE=Asia/Kolkata
